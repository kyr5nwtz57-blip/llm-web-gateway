+class MailcxTokenBusy(Exception):
+    """mail.cx 同一 key 同时只允许一个活跃连接，繁忙时会返回 {"error":"token_busy"}。
+
+    这不是"没有验证码"，必须与"真的没收到码"区分：否则批量注册会把
+    繁忙误判成收码失败，整批假失败。
+    """
+
+    def __init__(self, op: str):
+        super().__init__(f"token_busy: {op}")
+        self.op = op
