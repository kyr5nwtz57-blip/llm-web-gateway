+def _is_invalid_token_body(raw) -> bool:
+    """DeepSeek 网页端的 token 失效形态：HTTP 200 + {"code":40003|40005|40006}。
+
+    relogin 只在 HTTP 401 时触发，这类 200-status 的错误过去直接 502。
+    """
+    if not raw:
+        return False
+    txt = raw.decode("utf-8", "replace") if isinstance(raw, (bytes, bytearray)) else str(raw)
+    if not txt.lstrip().startswith("{"):
+        return False
+    try:
+        import json as _json
+        obj = _json.loads(txt)
+    except Exception:
+        return False
+    if not isinstance(obj, dict):
+        return False
+    code = obj.get("code")
+    msg = str(obj.get("msg", "") or "").upper()
+    if code in (40003, 40005, 40006) or "TOKEN" in msg and ("INVALID" in msg or "EXPIRED" in msg):
+        return True
+    return False
+
