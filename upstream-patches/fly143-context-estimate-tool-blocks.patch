+
+def _content_text(content: Any) -> str:
+    """文本化一个 content 值。
+
+    必须覆盖 tool_use / tool_result / thinking：这些块在 agentic 长任务里
+    占绝大多数字符。早先只取 type=="text"，导致估算值远低于实际发出的
+    prompt 体积（DeepSeek 的 prompt 由 convert_messages_for_deepseek 把
+    这些块也转成文本），裁剪器因此误判"未超限"。
+    """
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        return str(content)
+    parts: List[str] = []
+    for item in content:
+        if not isinstance(item, dict):
+            if item is not None:
+                parts.append(str(item))
+            continue
+        itype = item.get("type")
+        if itype == "text":
+            parts.append(item.get("text", "") or "")
+        elif itype == "tool_use":
+            parts.append(item.get("name", "") or "")
+            inp = item.get("input")
+            if inp is not None:
+                try:
+                    parts.append(json.dumps(inp, ensure_ascii=False))
+                except (TypeError, ValueError):
+                    parts.append(str(inp))
+        elif itype == "tool_result":
+            parts.append(_content_text(item.get("content", "")))
+        elif itype in ("thinking", "reasoning"):
+            parts.append(item.get("thinking", "") or item.get("text", "") or "")
+        elif itype in ("image", "image_url", "document"):
+            parts.append(str(item.get("source", "") or item.get("url", "") or ""))
+        else:
+            for key in ("text", "content", "value"):
+                val = item.get(key)
+                if isinstance(val, str) and val:
+                    parts.append(val)
+                    break
+    return " ".join(p for p in parts if p)
 
 
